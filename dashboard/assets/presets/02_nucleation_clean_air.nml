! title: Nucleation from clean air
! description: No initial aerosol; constant H2SO4 production of 0.1 ppb/h with 1 ppb NH3 over 24 h. New particles nucleate in the Aitken mode, grow by condensation, coagulate and are renamed into the accumulation mode.
&time_input
mam_dt         = 600,
mam_nstep      = 144,
/
&cntl_input
mdo_mambox     = 1,
mdo_coldstart  = 1,
mdo_gaschem    = 0,
mdo_gasaerexch = 1,
mdo_rename     = 1,
mdo_newnuc     = 1,
mdo_coag       = 1,
accom_coef_h2so4 = 0.65,
accom_coef_hno3  = 0.1,
accom_coef_hcl   = 0.1,
accom_coef_nh3   = 0.092,
/
&met_input
mtmin           = 285,
mtmax           = 285,
mrhmin          = 0.5,
mrhmax         = 0.5,
press          = 100000.0,
/
&chem_input
masstot = 0.0,0.0,0.0,0.0
mfso4 = 0.0, 0.0, 0.0, 0.0
mfpom = 0.0, 0.0, 0.0, 0.0
mfsoa = 0.0, 0.0, 0.0, 0.0
mfbc  = 0.0, 0.0, 0.0, 0.0
mfdst = 0.0, 0.0, 0.0, 0.0
mfncl = 0.0, 0.0, 0.0, 0.0
mfno3 = 0.0, 0.0, 0.0, 0.0
mfnh4 = 0.0, 0.0, 0.0, 0.0
mfco3 = 0.0, 0.0, 0.0, 0.0
mfca  = 0.0, 0.0, 0.0, 0.0
mfcl  = 0.0, 0.0, 0.0, 0.0
qso2          = 0.0,
qh2so4        = 0.0,
qsoag         = 0.0,
qhno3         = 0.0,
qnh3          = 1.0,
qhcl          = 0.0
/
&emis_input
h2so4_prod    = 100.0,
hno3_prod     = 0.0,
nh3_prod      = 0.0,
hcl_prod      = 0.0,
soag_prod     = 0.0,
/
